﻿
@model Lorincz_Denisa_Lab4.TimePredictionModel.ModelInput

@{
    ViewData["Title"] = "Time Prediction";
}

<h2>Estimate Trip Duration</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Time">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Trip_distance" class="control-label">Distance (miles)</label>
                <input asp-for="Trip_distance" class="form-control" />
                <span asp-validation-for="Trip_distance" class="text-danger"></span>
            </div>

            <div class="form-group">
                <br />
                <input type="submit" value="Estimate Time" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <div class="col-md-offset-2 col-md-4">
        @if (ViewBag.Time != null)
        {
            <h1>Result</h1>
            <h2>Duration: @(float.Parse(ViewBag.Time.ToString()) / 60) minutes</h2>
            <p>(@ViewBag.Time seconds)</p>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}